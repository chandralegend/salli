# Copy to .env and fill in values. Never commit .env.

# Database (Supabase Postgres, Singapore region)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Project Settings → API → JWT Secret  (REQUIRED in production)
SUPABASE_JWT_SECRET=your-jwt-secret-here

# LangSmith (optional — traces every agent run)
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=salli

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
BASE_CURRENCY=LKR

# Tavily (web search for the agent)
TAVILY_API_KEY=tvly-...

# Paddle (Billing — Merchant of Record)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
# Paddle price IDs that map a subscription back to a plan + billing cycle.
# PLUS = the "Starter" plan; PRO = the "Pro" plan. _YEARLY are the annual prices.
PADDLE_PRICE_PLUS=
PADDLE_PRICE_PRO=
PADDLE_PRICE_PLUS_YEARLY=
PADDLE_PRICE_PRO_YEARLY=

# Issue tracker — Jira Cloud. User-submitted bug reports are mirrored here.
# Leave blank and reports are still stored in Salli (push_status "skipped"),
# so the reporter works fine before any of this is configured.
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
# The account below needs "Create issues" permission on the project.
JIRA_BASE_URL=https://<yoursite>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Bug

# Daily Wealth Advisor scheduling (Supabase pg_cron → API)
CRON_SECRET=
ADVISOR_API_BASE_URL=http://host.docker.internal:8000

# MCP — lets external AI clients (Claude, ChatGPT, etc.) connect via OAuth.
# mcp_public_base_url is this API's own public URL (the MCP resource + OAuth
# issuer); app_base_url is where the consent screen lives (the web app).
# Prod values are set by infra/index.ts (apiUrl / appUrl) — leave as localhost here.
MCP_PUBLIC_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000
