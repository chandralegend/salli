# Copy to .env and fill in values. Never commit .env.

# Database (Supabase Postgres, Singapore region)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Project Settings → API → JWT Secret  (REQUIRED in production)
SUPABASE_JWT_SECRET=your-jwt-secret-here

# LangSmith (optional — traces every agent run)
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=salli

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
BASE_CURRENCY=LKR

# Tavily (web search for the agent)
TAVILY_API_KEY=tvly-...

# Paddle (Billing — Merchant of Record)
#
# Server-side API key: Paddle → Developer Tools → Authentication → API keys.
# Sandbox and production are separate accounts with separate keys; this one must
# match PADDLE_ENVIRONMENT below, and the client token in clients/web/.env.local
# must come from the same account.
PADDLE_API_KEY=
# Signing secret of ONE notification destination (not an account-wide secret):
# Paddle → Developer Tools → Notifications → <destination> → Secret key, starting
# "pdl_ntfset_". Create another destination and it gets a different secret. If it
# does not match, every delivery fails signature verification and returns 400,
# which looks exactly like no webhook arriving at all.
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
# Paddle price IDs that map a subscription back to a plan + billing cycle.
# PRO = the "Pro" plan (the only paid tier). _YEARLY is the annual price.
# Copy from Paddle → Catalog → Products → <product> → Prices ("pri_...").
PADDLE_PRICE_PRO=
PADDLE_PRICE_PRO_YEARLY=
#
# One-time credit packs. Create these in Paddle as **one-off** prices, not
# recurring ones — a top-up modelled as a subscription item would be deleted
# the next time the user changed plan (see PaddleBillingAdapter._change_body).
# Sandbox prices already exist under the "Salli AI Credits" product.
PADDLE_PRICE_CREDITS_10K=
PADDLE_PRICE_CREDITS_25K=
PADDLE_PRICE_CREDITS_60K=
#
# ── RevenueCat (iOS purchases) ────────────────────────────────────────────────
#
# Paddle cannot serve iOS outside the US: its external checkout is US-only, and
# Apple's other carve-outs are the EU and South Korea. Sri Lankan users must go
# through StoreKit, and RevenueCat is the layer over it.
#
# Signing secret from RevenueCat -> Integrations -> Webhooks (enable HMAC
# signing). No API key is needed: everything required to grant credits arrives
# in the signed payload, so the backend makes no outbound RevenueCat call.
REVENUECAT_WEBHOOK_SECRET=
# App Store Connect consumable product identifiers, mirrored in RevenueCat.
# These must match the products exactly or a paid purchase grants nothing.
REVENUECAT_PRODUCT_CREDITS_10K=
REVENUECAT_PRODUCT_CREDITS_25K=
REVENUECAT_PRODUCT_CREDITS_60K=
#
# ── Testing checkout locally ──────────────────────────────────────────────────
# Paddle will not accept localhost as a default payment link, and its servers
# cannot reach your machine, so local checkout needs a public https tunnel:
#
#   ngrok http 3003 --url=https://<your-static>.ngrok-free.dev
#
# Then, in the *sandbox* dashboard (sandbox-vendors.paddle.com — settings saved
# in the live dashboard do nothing for a test_ client token):
#
#   1. Checkout → Checkout settings → Default payment link:
#        https://<your-static>.ngrok-free.dev/settings
#      Without it, opening checkout fails with
#      "transaction_default_checkout_url_not_set".
#   2. Developer Tools → Notifications → New destination:
#        https://<your-static>.ngrok-free.dev/api/billing/webhook
#      (/api is the dev-only rewrite in clients/web/next.config.ts, which
#      forwards to this API on :8000 — the tunnel points at the web app, not
#      here.) Subscribe to transaction.completed and subscription.created /
#      updated / canceled, then copy its secret into PADDLE_WEBHOOK_SECRET.
#   3. Set DEV_TUNNEL_HOSTS and NEXT_PUBLIC_API_URL=/api in
#      clients/web/.env.local, and add the tunnel URL to the Supabase dashboard
#      under Authentication → URL Configuration → Redirect URLs, or OAuth login
#      bounces to the Site URL and fails with bad_oauth_state.
#
# Plan state only ever changes through a webhook: checkout completing in the
# browser writes nothing. Paddle delivers events solely to destinations that
# already existed when the event fired, so a purchase made before step 2 will
# never appear — buy again, or trigger a subscription.updated with a no-op
# PATCH /subscriptions/<id> against the Paddle API.

# Issue tracker — Jira Cloud. User-submitted bug reports are mirrored here.
# Leave blank and reports are still stored in Salli (push_status "skipped"),
# so the reporter works fine before any of this is configured.
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
# The account below needs "Create issues" permission on the project.
JIRA_BASE_URL=https://<yoursite>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Bug

# Daily Wealth Advisor scheduling (Supabase pg_cron → API)
CRON_SECRET=
ADVISOR_API_BASE_URL=http://host.docker.internal:8000

# MCP — lets external AI clients (Claude, ChatGPT, etc.) connect via OAuth.
# mcp_public_base_url is this API's own public URL (the MCP resource + OAuth
# issuer); app_base_url is where the consent screen lives (the web app).
# Prod values are set by infra/index.ts (apiUrl / appUrl) — leave as localhost here.
MCP_PUBLIC_BASE_URL=http://localhost:8000
# The web app's dev server runs on 3003 (clients/web/package.json).
APP_BASE_URL=http://localhost:3003
