# API base URL. Point this at the API host reachable from your device/simulator
# — "localhost" won't resolve from a physical phone or the Android emulator.
# Production: https://salli-api.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8080

# Supabase (Auth). When unset, the app falls back to local dev-login.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web app origin. Billing checkout has no native Paddle SDK, so the Billing screen
# opens this URL's Settings page (Paddle.js overlay) in an in-app browser.
EXPO_PUBLIC_SITE_URL=https://salli.lk
