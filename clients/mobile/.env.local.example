# API base URL. Point this at the API host reachable from your device/simulator
# — "localhost" won't resolve from a physical phone or the Android emulator.
# Production: https://salli-api.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8080

# Supabase (Auth). When unset, the app falls back to local dev-login.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat SDK key (iOS). Public by design — it ships inside the app bundle,
# like any client-side key. From RevenueCat -> Project -> API keys -> Apple.
# Absent means purchasing is hidden entirely rather than shown broken.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
