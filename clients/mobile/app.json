{
  "expo": {
    "name": "Salli",
    "slug": "salli-mobile",
    "scheme": "salli",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.salli.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "lk.salli.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#16130f",
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Salli uses your microphone in Voice Mode so you can talk to Salli instead of typing."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Salli uses your microphone in Voice Mode so you can talk to Salli instead of typing.",
          "speechRecognitionPermission": "Salli turns your speech into text on your device, so what you say never leaves your phone.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "365a37c2-8680-47df-b8df-c7cdf7a33e01"
      }
    },
    "owner": "chandralegend"
  }
}
