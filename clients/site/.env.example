# Where the app (Next.js SaaS, clients/web) is served.
# Dev: http://localhost:3003   Prod: https://app.salli.leafmonkey.org
# This site links to the app for sign-in and pricing CTAs; checkout itself runs
# in clients/web, so no Paddle credentials belong here.
NEXT_PUBLIC_APP_URL=http://localhost:3003

# This site's own canonical origin — feeds sitemap.xml, robots.txt, metadataBase
# and JSON-LD, so it must be absolute and match the domain actually served.
# Leave unset outside production: it falls back to https://salli.leafmonkey.org.
NEXT_PUBLIC_SITE_URL=
