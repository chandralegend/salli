  "components": {
    "schemas": {
      "AddAccountRequest": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "asset",
              "liability",
              "equity",
              "income",
              "expense"
            ],
            "title": "Type"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "LKR"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "type"
        ],
        "title": "AddAccountRequest"
      },
      "AddEntryRequest": {
        "properties": {
          "entry_date": {
            "type": "string",
            "title": "Entry Date"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "statement",
              "sms",
              "system"
            ],
            "title": "Source",
            "default": "manual"
          },
          "external_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Ref"
          },
          "postings": {
            "items": {
              "$ref": "#/components/schemas/PostingRequest"
            },
            "type": "array",
            "title": "Postings"
          }
        },
        "type": "object",
        "required": [
          "entry_date",
          "description",
          "postings"
        ],
        "title": "AddEntryRequest"
      },
      "Body_upload_statement_statements_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_statement_statements_upload_post"
      },
      "ChatRequest": {
        "properties": {
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "thread_id",
          "message"
        ],
        "title": "ChatRequest"
      },
      "CreateReminderRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "due_date": {
            "type": "string",
            "title": "Due Date"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "due_date"
        ],
        "title": "CreateReminderRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PostRequest": {
        "properties": {
          "approved_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Approved Ids"
          }
        },
        "type": "object",
        "required": [
          "approved_ids"
        ],
        "title": "PostRequest"
      },
